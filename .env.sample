# gh and Copilot CLI: a fine-grained token (github_pat_) with Git SSH keys and SSH signing keys (read and write) and Copilot Requests. Copilot rejects classic ghp_ tokens.
# GH_TOKEN=<your-github-token>
# GITGUARDIAN_API_KEY=<your-gitguardian-api-key>
# GITGUARDIAN_INSTANCE=https://dashboard.gitguardian.com
# NPM_CONFIG_REGISTRY=https://artifactory.example.com/api/npm/npm/
# SNYK_API=https://api.snyk.io
# SNYK_TOKEN=<your-snyk-token>
# UV_DEFAULT_INDEX=https://artifactory.example.com/api/pypi/pypi/simple
