# The env file: copy to .env in this directory (scripts/setup does it on the first run) and uncomment what this machine needs.
# .env is gitignored and never committed (specs/adr/0010). Every zsh exports it from ~/.zshenv, and scripts/setup exports it before installing anything.
# Plain KEY=value lines, sourced by bash and zsh: quote a value that holds spaces. Leave unused lines commented: an empty value is not the same as unset.

# ── Package mirrors (work) ────────────────────────────────────────────────
# UV_DEFAULT_INDEX=https://artifactory.example.com/api/pypi/pypi/simple
# UV_PYTHON_INSTALL_MIRROR=https://artifactory.example.com/artifactory/github/astral-sh/python-build-standalone/releases/download
# NPM_CONFIG_REGISTRY=https://artifactory.example.com/api/npm/npm/

# ── Security scanners ─────────────────────────────────────────────────────
# GitGuardian (ggshield): dashboard > API > Personal access tokens.
# GITGUARDIAN_API_KEY=
# GITGUARDIAN_INSTANCE=https://dashboard.gitguardian.com
# Snyk: account settings > Auth Token.
# SNYK_TOKEN=
# SNYK_API=https://api.snyk.io
