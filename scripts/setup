#!/usr/bin/env bash
#
# scripts/setup - bootstrap this distro and run the dotfiles playbook. Safe to re-run.
#
#   bash -c "$(curl -fsSL https://raw.githubusercontent.com/irish1986/dotfiles/main/scripts/setup)" -- --profile work
#
# The first run creates ~/.config/dotfiles/local.yml and stops so you can edit it. Every later run trusts the corporate CA (work), installs uv and ansible-core through the package mirror the local file names, updates the checkout and runs the playbook. Anything it does not know goes to ansible-playbook:
#
#   ~/.dotfiles/scripts/setup --tags zsh,git --check --diff

set -Eeuo pipefail

readonly REPO_HTTPS_URL="https://github.com/irish1986/dotfiles.git"
readonly REPO_SSH_URL="git@github.com:irish1986/dotfiles.git"
# Ceiling: 2.24 removes INJECT_FACTS_AS_VARS, which ansible.cfg sets.
readonly ANSIBLE_CORE_SPEC="ansible-core>=2.16,<2.24"
readonly DOTFILES_DIR="${DOTFILES_DIR:-${HOME}/.dotfiles}"
readonly LOCAL_FILE="${DOTFILES_LOCAL_FILE:-${HOME}/.config/dotfiles/local.yml}"
readonly CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

profile=""
pull=1
playbook_args=()

info() { printf '==> %s\n' "$*"; }
die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

# One top-level scalar of the local file, without quotes or a trailing comment.
local_get() {
  [[ -f $LOCAL_FILE ]] || return 0
  sed -n "s/^${1}:[[:space:]]*//p" "$LOCAL_FILE" | head -n1 | sed -E 's/[[:space:]]+#.*$//; s/^["'\'']//; s/["'\'']$//'
}

while (($#)); do
  case "$1" in
    --profile) profile="${2:?--profile needs personal or work}" && shift 2 ;;
    --no-pull) pull=0 && shift ;;
    -h | --help) sed -n '3,9p' "$0" && exit 0 ;;
    --) shift ;;
    *) playbook_args+=("$1") && shift ;;
  esac
done

[[ $EUID -ne 0 ]] || die "run this as your own user; it uses sudo where needed"
# shellcheck disable=SC1091 # runtime file
[[ "$(. /etc/os-release && printf '%s %s' "$ID" "$VERSION_ID")" == "ubuntu 26.04" ]] || die "this sets up Ubuntu 26.04 only"

profile="${profile:-$(local_get dotfiles_profile)}"
[[ $profile == personal || $profile == work ]] || die "say which profile this machine gets: --profile personal or --profile work"

# apt reads the archive over plain HTTP, so this works before the corporate CA is trusted.
missing=()
for pkg in ca-certificates curl git openssl python3; do
  dpkg-query -W -f='${Status}' "$pkg" 2> /dev/null | grep -q 'ok installed' || missing+=("$pkg")
done
if ((${#missing[@]})); then
  info "Installing ${missing[*]}"
  sudo apt-get -o DPkg::Lock::Timeout=600 update -qq
  sudo DEBIAN_FRONTEND=noninteractive apt-get -o DPkg::Lock::Timeout=600 install -y -qq --no-install-recommends "${missing[@]}"
fi

# The corporate CA next: until it is trusted, every download below fails behind the TLS-inspecting proxy. The same file, converted the same way, as roles/certificates installs.
if [[ $profile == work ]]; then
  ca="$(local_get certificates_corporate_ca)"
  ca="${ca:-zscaler.cer}"
  [[ $ca == /* ]] || ca="/mnt/c/Users/$(local_get dotfiles_windows_user | grep . || printf '%s' "$USER")/${ca}"
  [[ -f $ca ]] || die "${ca} is missing: export the Zscaler root certificate there from Windows (certmgr.msc), then re-run"
  dest="/usr/local/share/ca-certificates/$(basename "${ca%.*}").crt"
  pem="$(openssl x509 -in "$ca" 2> /dev/null || openssl x509 -inform DER -in "$ca")"
  if [[ "$(cat "$dest" 2> /dev/null)" != "$pem" ]]; then
    info "Trusting ${ca}"
    printf '%s\n' "$pem" | sudo tee "$dest" > /dev/null
    # Quiet: openssl rehash warns about the bundle file itself on every run.
    sudo update-ca-certificates > /dev/null 2>&1 || die "update-ca-certificates failed"
  fi
fi
export SSL_CERT_FILE="$CA_BUNDLE"

if [[ ! -d ${DOTFILES_DIR}/.git ]]; then
  info "Cloning into ${DOTFILES_DIR}"
  # HTTPS needs no key; origin then moves to SSH, which the playbook sets up.
  git clone --quiet "$REPO_HTTPS_URL" "$DOTFILES_DIR"
  git -C "$DOTFILES_DIR" remote set-url origin "$REPO_SSH_URL"
elif ((pull)); then
  git -C "$DOTFILES_DIR" pull --ff-only --autostash --quiet || info "could not fast-forward ${DOTFILES_DIR}; using it as it is"
fi

if [[ ! -f $LOCAL_FILE ]]; then
  mkdir -p "$(dirname "$LOCAL_FILE")"
  (umask 077 && sed "s/^dotfiles_profile: .*/dotfiles_profile: ${profile}/" "${DOTFILES_DIR}/docs/examples/local.yml" > "$LOCAL_FILE")
  info "Created ${LOCAL_FILE}. Fill in your git identity$([[ $profile == work ]] && printf ' and the package mirrors'), then run ${DOTFILES_DIR}/scripts/setup again."
  exit 0
fi
[[ "$(local_get dotfiles_profile)" == "$profile" ]] || sed -i "s/^dotfiles_profile:.*/dotfiles_profile: ${profile}/" "$LOCAL_FILE"

# ansible-core from uv, through the PyPI mirror when there is one: the archive's is too old, and PEP 668 rules out pip.
if [[ ! -x ${HOME}/.local/bin/uv ]]; then
  info "Installing uv"
  curl -fsSL https://astral.sh/uv/install.sh | env UV_NO_MODIFY_PATH=1 sh -s -- --quiet
fi
export PATH="${HOME}/.local/bin:${PATH}"
mirror="$(local_get tools_pypi_mirror)"
[[ -z $mirror ]] || export UV_DEFAULT_INDEX="$mirror"
mirror="$(local_get tools_python_install_mirror)"
[[ -z $mirror ]] || export UV_PYTHON_INSTALL_MIRROR="$mirror"
uv tool install --quiet "$ANSIBLE_CORE_SPEC"

cd "$DOTFILES_DIR"
export ANSIBLE_CONFIG="${DOTFILES_DIR}/ansible.cfg"
# The system role grants NOPASSWD; until it has, ansible needs the password.
sudo -n -l 2> /dev/null | grep -q NOPASSWD || playbook_args+=(--ask-become-pass)
ansible-playbook main.yml "${playbook_args[@]}"
