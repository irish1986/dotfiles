{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Versions pinned in profiles and role defaults, each annotated with a `# renovate: datasource=... depName=...` comment on the line above. Versions are stored without a leading v; URL templates add it where upstream tags carry one.",
      "extractVersionTemplate": "^v?(?<version>.+)$",
      "managerFilePatterns": [
        "/^profiles/.+\\.ya?ml$/",
        "/^roles/.+/defaults/main\\.ya?ml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*(?:-\\s+)?[a-z_]*version:\\s*\"?(?<currentValue>[^\"\\s]+)\"?"
      ]
    }
  ],
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Renovate Dashboard",
  "enabledManagers": [
    "ansible-galaxy",
    "custom.regex",
    "github-actions",
    "pre-commit"
  ],
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",
    ":timezone(America/Toronto)"
  ],
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "addLabels": [
        "type/minor"
      ],
      "automerge": true,
      "automergeType": "pr",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pinDigest"
      ],
      "platformAutomerge": true
    },
    {
      "addLabels": [
        "type/major"
      ],
      "automerge": false,
      "matchUpdateTypes": [
        "major"
      ]
    },
    {
      "addLabels": [
        "github-actions"
      ],
      "groupName": "github actions",
      "matchManagers": [
        "github-actions"
      ]
    },
    {
      "addLabels": [
        "pre-commit"
      ],
      "groupName": "pre-commit hooks",
      "matchManagers": [
        "pre-commit"
      ]
    },
    {
      "addLabels": [
        "ansible"
      ],
      "groupName": "ansible collections",
      "matchManagers": [
        "ansible-galaxy"
      ]
    }
  ],
  "pre-commit": {
    "enabled": true
  },
  "schedule": [
    "before 6am on monday"
  ]
}
