{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Renovate Dashboard",
  "enabledManagers": [
    "ansible-galaxy"
  ],
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",
    ":timezone(America/Toronto)"
  ],
  "labels": [
    "dependencies",
    "ansible",
    "renovate/ansible"
  ],
  "packageRules": [
    {
      "addLabels": [
        "type/minor"
      ],
      "automerge": true,
      "automergeType": "pr",
      "groupName": "ansible collections",
      "groupSlug": "ansible-collections",
      "matchManagers": [
        "ansible-galaxy"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "platformAutomerge": true
    },
    {
      "addLabels": [
        "type/major"
      ],
      "automerge": false,
      "matchManagers": [
        "ansible-galaxy"
      ],
      "matchUpdateTypes": [
        "major"
      ]
    }
  ],
  "schedule": [
    "before 6am on monday"
  ]
}
