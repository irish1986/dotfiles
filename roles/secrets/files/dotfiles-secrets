#!/usr/bin/env bash
#
# dotfiles-secrets - write this machine's secrets where they are used (ADR 0012). Installed by roles/secrets, which renders the config below from the local file.
#
#   dotfiles-secrets sync           every target
#   dotfiles-secrets sync --shell   only the shell target: the cache ~/.zshenv sources
#   dotfiles-secrets path           print where the shell cache lives
#
# Read-only: secrets are edited at their source -- Infisical, or ~/.config/dotfiles/secrets/<target>.env -- never here. A target whose fetch fails keeps its last good file.

set -Eeuo pipefail

readonly CONFIG_FILE="${DOTFILES_SECRETS_CONFIG:-${HOME}/.config/dotfiles/secrets.conf}"
readonly HEADER="# Managed by dotfiles-secrets. Edit the secret at its source; the next sync overwrites this file."
# In RAM, so it goes away at reboot. A fixed path rather than XDG_RUNTIME_DIR, which is set in some contexts (a login shell) and not others (sudo, the playbook), and would split the cache in two. ~/.zshenv derives the same path.
readonly CACHE_DIR="${DOTFILES_SECRETS_CACHE_DIR:-/dev/shm/dotfiles-secrets-$(id -u)}"

cfg_source=""
cfg_project=""
cfg_local_dir=""
cfg_credentials=""
targets=()
token=""
failures=0

warn() { printf 'dotfiles-secrets: %s\n' "$*" >&2; }
die() {
  warn "$*"
  exit 1
}

usage() {
  sed -n '3,9s/^# \{0,1\}//p' "$0"
}

load_config() {
  [[ -r $CONFIG_FILE ]] || die "no config at ${CONFIG_FILE}; the secrets role writes it from secrets_* in the local file"
  local line key value
  while IFS= read -r line || [[ -n $line ]]; do
    [[ -z $line || $line == \#* ]] && continue
    key="${line%%=*}"
    value="${line#*=}"
    case "$key" in
      source) cfg_source="$value" ;;
      project) cfg_project="$value" ;;
      local_dir) cfg_local_dir="$value" ;;
      credentials) cfg_credentials="$value" ;;
      target) targets+=("$value") ;;
      *) die "unknown key '${key}' in ${CONFIG_FILE}" ;;
    esac
  done < "$CONFIG_FILE"
  case "$cfg_source" in
    infisical | local) ;;
    *) die "source must be infisical or local, not '${cfg_source}' (${CONFIG_FILE})" ;;
  esac
}

# ── Sources ───────────────────────────────────────────────────────────────
# The machine identity's credential file: KEY=VALUE lines, parsed rather than sourced. Its values reach the CLI through the environment, never argv, so they do not show in ps.
infisical_login() {
  [[ -n $token ]] && return 0
  [[ -r $cfg_credentials ]] || {
    warn "no Infisical credentials at ${cfg_credentials}; scripts/setup asks for them, or write INFISICAL_UNIVERSAL_AUTH_CLIENT_ID= and INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET= lines there (mode 0600)"
    return 1
  }
  local key value id="" secret=""
  while IFS='=' read -r key value || [[ -n $key ]]; do
    case "$key" in
      INFISICAL_UNIVERSAL_AUTH_CLIENT_ID) id="$value" ;;
      INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET) secret="$value" ;;
    esac
  done < "$cfg_credentials"
  [[ -n $id && -n $secret ]] || {
    warn "${cfg_credentials} lacks INFISICAL_UNIVERSAL_AUTH_CLIENT_ID or INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET"
    return 1
  }
  token="$(INFISICAL_UNIVERSAL_AUTH_CLIENT_ID="$id" INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET="$secret" \
    infisical login --method=universal-auth --plain --silent)" || {
    warn "could not log in to Infisical"
    return 1
  }
}

# fetch NAME ENV PATH FORMAT: the target's secrets, as dotenv, on stdout.
fetch() {
  case "$cfg_source" in
    local)
      local file="${cfg_local_dir}/$1.env"
      [[ -r $file ]] || {
        warn "no local secrets file ${file}"
        return 1
      }
      cat "$file"
      ;;
    infisical)
      infisical_login || return 1
      INFISICAL_TOKEN="$token" infisical export --silent \
        "--projectId=${cfg_project}" "--env=$2" "--path=$3" "--format=$4"
      ;;
  esac
}

# ── Writing ───────────────────────────────────────────────────────────────
# install_file CONTENT DEST NAME: header + content, 0600, replaced atomically and only when it changed. Prints updated/unchanged.
install_file() {
  local content="$1" dest="$2" name="$3" tmp
  tmp="$(mktemp "$(dirname "$dest")/.dotfiles-secrets.XXXXXX")"
  { printf '%s\n' "$HEADER" && cat "$content"; } > "$tmp"
  if [[ -f $dest ]] && cmp -s "$tmp" "$dest"; then
    rm -f "$tmp"
    printf 'unchanged %s\n' "$name"
  else
    chmod 0600 "$tmp"
    mv -f "$tmp" "$dest"
    printf 'updated %s\n' "$name"
  fi
}

ensure_cache_dir() {
  [[ -d $CACHE_DIR ]] || mkdir -m 0700 "$CACHE_DIR"
  # /dev/shm is world-writable: refuse a directory someone else created, or a link to one.
  [[ ! -L $CACHE_DIR && -O $CACHE_DIR ]] || die "${CACHE_DIR} is not a directory owned by $(id -un)"
  chmod 0700 "$CACHE_DIR"
}

# check_project_dest DEST: a project .env is only written where git will not commit it. Outside a git work tree there is nothing to commit it to.
check_project_dest() {
  local dest="$1" dir
  dir="$(dirname "$dest")"
  [[ -d $dir ]] || {
    warn "${dir} does not exist"
    return 1
  }
  if git -C "$dir" rev-parse --is-inside-work-tree > /dev/null 2>&1 \
    && ! git -C "$dir" check-ignore -q "$dest"; then
    warn "${dest} is not ignored by git; add it to .gitignore first"
    return 1
  fi
}

# backup_hand_made DEST: a .env this script did not write is kept once as .pre-dotfiles. Called only once the replacement is fetched, so a failed fetch never leaves a project without its file.
backup_hand_made() {
  local dest="$1"
  if [[ -e $dest ]] && [[ "$(head -n 1 "$dest")" != "$HEADER" ]]; then
    [[ ! -e ${dest}.pre-dotfiles ]] || {
      warn "${dest} was not written by dotfiles-secrets, and ${dest}.pre-dotfiles already exists; move one of them away"
      return 1
    }
    mv "$dest" "${dest}.pre-dotfiles"
    warn "kept the existing ${dest} as ${dest}.pre-dotfiles"
  fi
}

sync_target() {
  local name dest env path format content
  IFS=$'\t' read -r name dest env path <<< "$1"
  if [[ $dest == shell ]]; then
    format=dotenv-export
    ensure_cache_dir
    dest="${CACHE_DIR}/shell.env"
  else
    format=dotenv
    check_project_dest "$dest" || return 1
  fi
  content="$(mktemp)"
  if ! fetch "$name" "$env" "$path" "$format" > "$content" \
    || { [[ $dest != "${CACHE_DIR}/shell.env" ]] && ! backup_hand_made "$dest"; }; then
    rm -f "$content"
    return 1
  fi
  install_file "$content" "$dest" "$name"
  rm -f "$content"
}

sync() {
  local shell_only=0 target
  [[ ${1:-} == --shell ]] && shell_only=1
  load_config
  for target in "${targets[@]}"; do
    if ((shell_only)) && [[ $(cut -f2 <<< "$target") != shell ]]; then
      continue
    fi
    if ! sync_target "$target"; then
      printf 'failed %s\n' "$(cut -f1 <<< "$target")"
      failures=$((failures + 1))
    fi
  done
  ((failures == 0))
}

main() {
  umask 077
  case "${1:-}" in
    sync)
      shift
      sync "$@"
      ;;
    path) printf '%s/shell.env\n' "$CACHE_DIR" ;;
    -h | --help | help) usage ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
