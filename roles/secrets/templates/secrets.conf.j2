# Managed by the dotfiles playbook (roles/secrets), from secrets_* in the local file. Read by dotfiles-secrets.
source={{ secrets_source }}
project={{ secrets_infisical_project }}
local_dir={{ secrets_local_dir }}
credentials={{ secrets_credentials_file }}
{% for secrets_target in secrets_targets %}
target={{ secrets_target.name }}	{{ secrets_target.dest if secrets_target.dest == 'shell' else (secrets_target.dest | expanduser) }}	{{ secrets_target.env | default('dev', true) }}	{{ secrets_target.path | default('/', true) }}
{% endfor %}
