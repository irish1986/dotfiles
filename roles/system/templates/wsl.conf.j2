# Managed by the dotfiles playbook (roles/system). Do not edit.
#
# Changes to this file apply once the distro restarts: `wsl --terminate <distro>` from Windows.

[boot]
systemd = {{ system_wsl_systemd | bool | lower }}

[automount]
enabled = {{ system_wsl_automount_enabled | bool | lower }}
root = {{ system_wsl_automount_root }}
options = "{{ system_wsl_automount_options }}"
mountFsTab = {{ system_wsl_automount_mount_fstab | bool | lower }}

[interop]
enabled = {{ system_wsl_interop_enabled | bool | lower }}
appendWindowsPath = {{ system_wsl_interop_append_windows_path | bool | lower }}

[network]
hostname = {{ system_wsl_network_hostname }}
generateHosts = {{ system_wsl_network_generate_hosts | bool | lower }}
generateResolvConf = {{ system_wsl_network_generate_resolv_conf | bool | lower }}

[user]
default = {{ system_wsl_default_user }}
