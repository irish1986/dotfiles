# Managed by the dotfiles playbook (roles/wsl). Piped over stdin, never written to disk, which also sidesteps ExecutionPolicy entirely.
#
# Registration only: the files themselves are copied from Linux by the copy module, which compares checksums. Every line of output is one of REGISTERED:, MISSING:, or nothing -- the task's changed_when matches ^REGISTERED: exactly, since a substring test would also match a longer marker.
$ErrorActionPreference = 'Stop'
Add-Type -AssemblyName PresentationCore

$dryRun = ${{ ansible_check_mode | bool }}
$dest   = Join-Path $env:LOCALAPPDATA 'Microsoft\Windows\Fonts'
$reg    = 'HKCU:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts'
$fonts  = @(
{% for wsl_font_file in wsl_font_files.files | sort(attribute='path') %}
    '{{ wsl_font_file.path | basename | replace("'", "''") }}'
{% endfor %}
)

# NOT New-Item -Force: on an existing *registry* key that recreates it and deletes every value inside, so each run wiped the entire font registry -- including registrations made by other means -- and re-added only the fonts this script happened to process. -Force is safe for directories, not keys.
if (-not $dryRun -and -not (Test-Path $reg)) { New-Item -Path $reg -Force | Out-Null }

# The registry value *name* must be the font's Win32 friendly name, e.g. "Hack Nerd Font Bold (TrueType)" -- not the filename. GlyphTypeface is used rather than System.Drawing.PrivateFontCollection because the latter reports the family for every weight, so all four would collide on one key and only the last would survive.
function Get-FontFriendlyName([string]$Path) {
    $gt   = New-Object Windows.Media.GlyphTypeface ([Uri]$Path)
    $fam  = $gt.Win32FamilyNames.Values | Select-Object -First 1
    $face = $gt.Win32FaceNames.Values   | Select-Object -First 1
    (("$fam $face").Trim() -replace '\s+', ' ')
}

$missing = 0
foreach ($file in $fonts) {
    $target = Join-Path $dest $file
    if (-not (Test-Path -LiteralPath $target)) {
        # In a dry run the copy did not happen either, so an absent file is expected there.
        Write-Output "MISSING: $file"
        if (-not $dryRun) { $missing++ }
        continue
    }

    $name = "{0} (TrueType)" -f (Get-FontFriendlyName $target)
    # Per-user entries need the full path as the value; a bare filename only works for fonts under %windir%\Fonts.
    $have = (Get-ItemProperty -Path $reg -Name $name -ErrorAction SilentlyContinue).$name
    if ($have -eq $target) { continue }

    if (-not $dryRun) {
        New-ItemProperty -Path $reg -Name $name -Value $target -PropertyType String -Force | Out-Null
    }
    Write-Output "REGISTERED: $name"
}

if ($missing -gt 0) { exit 1 }
