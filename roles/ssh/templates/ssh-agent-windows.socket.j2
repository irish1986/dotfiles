# Managed by the dotfiles playbook (roles/ssh). Do not edit.
#
# The Windows ssh-agent, as a unix socket (ADR 0010). Each connection starts one npiperelay, which speaks to the agent's named pipe; nothing runs while nothing uses ssh.

[Unit]
Description=Windows OpenSSH agent relay
Documentation=https://github.com/albertony/npiperelay

[Socket]
ListenStream=%t/{{ ssh_relay_unit }}.sock
SocketMode=0600
Accept=yes
# The same mechanism Ubuntu's ssh-agent.socket uses, which this replaces: every service the user manager starts from here on -- the herdr server, and the shells in it -- gets the relay.
ExecStartPost=/usr/bin/systemctl --user set-environment SSH_AUTH_SOCK=%t/{{ ssh_relay_unit }}.sock
ExecStopPre=/usr/bin/systemctl --user unset-environment SSH_AUTH_SOCK

[Install]
WantedBy=sockets.target
