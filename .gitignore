.venv/
/.wip
.ansible
.env
.cache_ggshield

# Ignore the *contents* of group_vars, not the directory itself: git never
# descends into an excluded directory, so a negation for a file inside one can
# never re-include it. all.yml holds real machine identity and stays untracked.
/inventory/group_vars/*
!inventory/group_vars/sample.yml
